        }
    ],
    "keywords": [
        "api",
        "apiverve",
        "cuidgenerator",
        "cuid",
        "cuid generator",
        "collision resistant id",
        "unique identifier",
        "sortable id"
    ],
    "homepage": "https://apiverve.com/marketplace/cuidgenerator?utm_source=php&utm_medium=referral&utm_content=homepage",
    "support": {
        "email": "hello@apiverve.com",
        "docs": "https://docs.apiverve.com/ref/cuidgenerator",
        "source": "https://github.com/apiverve/cuidgenerator-API/tree/main/php"
    },
    "require": {
        "php": ">=7.4",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0"
    },
